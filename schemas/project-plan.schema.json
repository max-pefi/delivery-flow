{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-plan.schema.json",
  "title": "delivery-flow project plan",
  "description": "项目计划层：阶段、里程碑、依赖和容量。执行状态仍以飞书为真源。",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "version", "team_size", "phases"],
  "properties": {
    "project": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "team_size": {"type": "integer", "minimum": 0},
    "updated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "current_phase": {"type": ["string", "null"]},
    "phases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/phase"
      }
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status", "dependencies", "completion_criteria"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["pending", "ready", "in_progress", "blocked", "qa", "accepted", "done"]},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "parallel_with": {"type": "array", "items": {"type": "string"}},
        "milestones": {"type": "array", "items": {"type": "string"}},
        "epics": {"type": "array", "items": {"type": "string"}},
        "owner": {"type": ["string", "null"]},
        "completion_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "gate_evidence": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "string"}
      }
    }
  }
}
