{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa-report.schema.json",
  "title": "delivery-flow QA report",
  "description": "阶段 QA 和回归证据，不要求 AI 评测。",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "phase", "conclusion", "test_scope", "evidence", "defects"],
  "properties": {
    "project": {"type": "string", "minLength": 1},
    "phase": {"type": "string", "minLength": 1},
    "conclusion": {"enum": ["pass", "conditional", "fail", "pending"]},
    "test_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "regression_scope": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "defects": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "status"], "properties": {"id": {"type": "string"}, "status": {"type": "string"}, "severity": {"type": "string"}}}},
    "notes": {"type": "string"}
  }
}
